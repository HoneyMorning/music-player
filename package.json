{
  "name": "music-player",
  "version": "0.2.0",
  "description": "A basic web app from React, called awesome-react",
  "scripts": {
    "start": "webpack serve --config config/webpack.dev.js",
    "start-browser": "webpack serve --config config/webpack.dev.js --open",
    "build": "webpack --config config/webpack.prod.js --progress",
    "test": "jest",
    "lint": "eslint --ext .jsx --ext .js src/",
    "format": "npm-run-all format-*",
    "format-jsx": "prettier src/**/*.js src/**/*.jsx --trailing-comma=es5 --write && yarn run lint --fix",
    "format-style": "prettier src/**/*.css src/**/*.scss --write",
    "format-md": "prettier README.md src/**/*.md docs/**/*.md --write",
    "server": "http-server ./dist/ -p 9000",
    "prepare": "husky",
    "commitmsg": "commitlint -e $GIT_PARAMS"
  },
  "keywords": [
    "react",
    "awesome-react",
    "react-app",
    "react-product"
  ],
  "author": "TaylorPzreal <taylorpzreal@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "bootstrap": "^5.3.0",
    "font-awesome": "^4.7.0",
    "prop-types": "^15.8.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-redux": "^9.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "autoprefixer": "^10.4.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.0",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^7.1.0",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-webpack-plugin": "^4.2.0",
    "html-webpack-plugin": "^5.6.0",
    "http-server": "^14.1.0",
    "husky": "^9.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "mini-css-extract-plugin": "^2.9.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.0",
    "postcss-flexbugs-fixes": "^5.0.0",
    "postcss-loader": "^8.1.0",
    "prettier": "^3.4.0",
    "sass": "^1.82.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.2.0",
    "webpack-manifest-plugin": "^5.0.0",
    "webpack-merge": "^6.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.jsx?$": "babel-jest",
      "^.+\\.s?css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|css|scss|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/config/",
      "<rootDir>/src/assets/"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "jsx"
    ],
    "moduleNameMapper": {
      ".+\\.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "identity-obj-proxy"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --trailing-comma=es5 --write",
      "eslint --fix"
    ],
    "src/**/*.{css,scss}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoneyMorning/music-player.git"
  },
  "bugs": {
    "url": "https://github.com/HoneyMorning/music-player/issues"
  },
  "homepage": "https://github.com/HoneyMorning/music-player#readme"
}
